FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
DATABASE_URL=sqlite:///instance/sak_music.db
RATELIMIT_DEFAULT=200/day;50/hour
SESSION_COOKIE_SECURE=False

# Optional: Email / SMTP settings for password reset emails
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_DEFAULT_SENDER="Sak Music <no-reply@sakmusic.local>"
